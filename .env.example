# Start safely in deterministic demo mode. Set false only with a live backend contract.
SALES_GENIE_DEMO_MODE=true
SALES_GENIE_BACKEND_BASE_URL=https://your-existing-backend.example.com
SALES_GENIE_BACKEND_API_PREFIX=/api/v1
SALES_GENIE_BACKEND_TOKEN=
# Optional JSON endpoint path overrides, e.g. {"follow_ups":"/tasks/follow-ups"}
SALES_GENIE_ENDPOINT_OVERRIDES_JSON=
SALES_GENIE_REQUEST_TIMEOUT_SECONDS=15
SALES_GENIE_REQUEST_RETRIES=2

# mock | openai | gemini. Keys are never committed or shown in the UI.
SALES_GENIE_LLM_PROVIDER=mock
SALES_GENIE_LLM_MODEL=deterministic-demo-v1
SALES_GENIE_LLM_TEMPERATURE=0.2
OPENAI_API_KEY=
GOOGLE_API_KEY=

SALES_GENIE_MAX_TRANSCRIPT_CHARS=42000
SALES_GENIE_SCORE_THRESHOLD_QUALIFIED=70
SALES_GENIE_SCORE_THRESHOLD_NURTURE=45
